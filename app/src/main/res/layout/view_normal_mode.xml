<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintBottom_toTopOf="@+id/tvLogHeader"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/cardFront"
            layout="@layout/item_distance_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <include
            android:id="@+id/cardDown"
            layout="@layout/item_distance_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <include
            android:id="@+id/cardLeft"
            layout="@layout/item_distance_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />

        <include
            android:id="@+id/cardRight"
            layout="@layout/item_distance_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1" />
    </GridLayout>

    <TextView
        android:id="@+id/tvLogHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Recent Alerts"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/scrollViewLog"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewLog"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="8dp"
        android:background="#F0F0F0"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvAlertLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="No alerts yet"
            tools:text="1. Obstacle ahead\n2. Object on left" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
